# Auth NextAuth
NEXTAUTH_SECRET=                    # openssl rand -base64 32
NEXTAUTH_URL=https://app-realisations.vercel.app

# Admins — OBLIGATOIRE : login:hash_bcrypt (plus de connexion sans MDP)
# Générer : npx tsx scripts/hash-password.ts "motdepasse"
AUTH_USER_1=admin:$2b$10$REMPLACER_PAR_HASH_BCRYPT

# Techniciens (identifiant:mot_de_passe_bcrypt[:uuid_technicien_supabase])
# Générer le hash : npx tsx scripts/hash-password.ts "1245"
# Si uuid absent, liaison auto au technicien dont le nom correspond à l'identifiant
# Exemple compte terrain : technicien1 / 1245 (migration 012_seed_technicien1.sql)
AUTH_TECH_1=technicien1:$2b$10$DSxM.2PKkvhsdSBbnFfSuutataaslgUAtBUYnMdmx5vAXg.xF323y
# AUTH_TECH_2=jean:$2b$10$...:uuid-du-technicien-dans-supabase
AUTH_USER_4=                        # optionnel
AUTH_USER_5=                        # optionnel

# APIs
# IA rapports / devis / factures (Anthropic par défaut)
AI_PROVIDER=anthropic                    # anthropic | mistral
ANTHROPIC_API_KEY=sk-ant-...             # https://console.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5        # rapports / devis / factures
AI_FLASH_MODEL=claude-haiku-4-5-20251001 # extract / health
MISTRAL_API_KEY=                         # optionnel (fallback si AI_PROVIDER=mistral)
AI_REPORT_MODEL=mistral-large-latest     # si AI_PROVIDER=mistral
OPENAI_API_KEY=sk-...                    # Whisper — dictée vocale (/api/transcribe)

# Django LTDB
LTDB_API_URL=https://lestechniciensdudebouchage.fr
LTDB_PUBLISH_TOKEN=                      # secret Vercel — ne jamais committer

# Identité légale (KBIS — aussi en table parametres Supabase)
LTDB_SIREN=484791546
LTDB_SIRET=48479154600050
NEXT_PUBLIC_LTDB_SIRET=48479154600050
LTDB_TVA_INTRACOM=FR09484791546
NEXT_PUBLIC_LTDB_RC_PRO=

# Resend (envoi email)
RESEND_API_KEY=re_...                # https://resend.com → API Keys
RESEND_FROM=Les Techniciens du Débouchage <contact@lestechniciensdudebouchage.fr>

# Brevo SMS (relances avis Google + Pages Jaunes — prioritaire sur Twilio)
BREVO_API_KEY=                         # https://app.brevo.com → SMTP & API → Clés API
BREVO_SMS_SENDER=LTDB                  # max 11 caractères alphanumériques
SMS_REVIEW_URL=https://lestechniciensdudebouchage.fr/avis
GOOGLE_REVIEW_URL=https://g.page/r/CascWzNKHgyEEAE/review
# Pages Jaunes — URL contribution (défaut déjà dans le code). Lien court optionnel pour le SMS :
PAGES_JAUNES_REVIEW_URL=https://www.pagesjaunes.fr/contribution/votre-avis/63850881?code_origine_sollicitation=slm&id_callback_sollicitation=7d2ec41affc340d2b53e756a928d4a9e&email=mondornaji@gmail.com
# SMS_PAGES_JAUNES_URL=https://lestechniciensdudebouchage.fr/avis-pj


# Cron Vercel (SMS avis horaires, etc.) — recommandé en prod
CRON_SECRET=                           # même valeur dans Vercel → Project Settings → Environment Variables

# Supabase (CRM / historique / base de données)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...     # Project Settings → Data API → service_role

# ----- OAuth réseaux (Vercel : URIs en https://app-realisations-ltdb.vercel.app/api/oauth/...) -----
# YouTube (Google Cloud → credentials OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app-realisations-ltdb.vercel.app/api/oauth/google/callback

# Google Business Profile (autre client OAuth si besoin)
GMB_CLIENT_ID=
GMB_CLIENT_SECRET=
GMB_REDIRECT_URI=https://app-realisations-ltdb.vercel.app/api/oauth/gmb/callback

# Facebook + Instagram (Meta for Developers → même app)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://app-realisations-ltdb.vercel.app/api/oauth/facebook/callback

# TikTok (developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://app-realisations-ltdb.vercel.app/api/oauth/tiktok/callback
